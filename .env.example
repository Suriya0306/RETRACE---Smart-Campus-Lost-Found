# Environment Variables Template
# Copy this file to .env and fill in with your actual values
# IMPORTANT: .env is in .gitignore - it won't be uploaded to GitHub

# ══════════════════════════════════════════════════════
# BACKEND - API Configuration
# ══════════════════════════════════════════════════════

# API Key for authentication
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=sk_track3_987654321

# Flask environment
# Options: development, production
FLASK_ENV=production

# ══════════════════════════════════════════════════════
# AI/ML Services - Required for core functionality
# ══════════════════════════════════════════════════════

# OpenAI API Key (for Whisper - speech to text)
# Get from: https://platform.openai.com/api-keys
# Cost: ~$0.02 per minute of audio
WHISPER_API_KEY=sk_live_your_openai_key_here

# Google Gemini API Key (for NLP analysis)
# Get from: https://aistudio.google.com/app/apikey
# Cost: Free tier available, generous limits
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# ══════════════════════════════════════════════════════
# Optional: Background Job Processing
# ══════════════════════════════════════════════════════

# Redis URL (for Celery task queue - optional)
# If not set, will use sync fallback
# Format: redis://localhost:6379/0
# Cloud Redis: redis://default:password@host:6379/0
REDIS_URL=redis://localhost:6379/0

# Celery broker URL (optional)
# Defaults to REDIS_URL if not set
CELERY_BROKER_URL=redis://localhost:6379/0

# ══════════════════════════════════════════════════════
# Database (optional - for persistence)
# ══════════════════════════════════════════════════════

# Database URL
# SQLite: sqlite:///calls.db
# PostgreSQL: postgresql://user:password@localhost/dbname
# MySQL: mysql+pymysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///calls.db

# ══════════════════════════════════════════════════════
# Frontend Configuration
# ══════════════════════════════════════════════════════

# API URL for frontend to call backend
# Development: http://localhost:5000
# Production (Render): https://your-api.onrender.com
# Set this in Vercel environment variables, not here
VITE_API_URL=http://localhost:5000

# ══════════════════════════════════════════════════════
# Server Configuration
# ══════════════════════════════════════════════════════

# Port for Flask server (Render sets PORT automatically)
PORT=5000

# Host to bind to
HOST=0.0.0.0

# Number of workers for production server (gunicorn)
WORKERS=4

# ══════════════════════════════════════════════════════
# Security & CORS
# ══════════════════════════════════════════════════════

# Allowed CORS origins (comma-separated)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGINS=*

# ══════════════════════════════════════════════════════
# Logging
# ══════════════════════════════════════════════════════

# Log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════
# Feature Flags (optional)
# ══════════════════════════════════════════════════════

# Enable AI analysis
ENABLE_AI=true

# Enable caching
ENABLE_CACHE=true

# Max file size for uploads (in bytes)
MAX_UPLOAD_SIZE=26214400

# ══════════════════════════════════════════════════════
# Setup Instructions
# ══════════════════════════════════════════════════════
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in the values:
#    - API_KEY: Use a secure random string
#    - WHISPER_API_KEY: Get from OpenAI
#    - GEMINI_API_KEY: Get from Google AI Studio
#
# 3. For Backend (Render):
#    Add these env vars in Render dashboard:
#    - API_KEY
#    - WHISPER_API_KEY
#    - GEMINI_API_KEY
#    - FLASK_ENV = production
#
# 4. For Frontend (Vercel):
#    Add env var in Vercel dashboard:
#    - VITE_API_URL = https://your-api.onrender.com
#
# ══════════════════════════════════════════════════════
# SECURITY WARNING
# ══════════════════════════════════════════════════════
#
# ⚠️  NEVER commit .env file to GitHub!
# ⚠️  Keep API keys secret and secure!
# ⚠️  Rotate keys regularly in production!
# ⚠️  Use environment variables, not hardcoded values!
#
# .env is already in .gitignore - it will NOT be uploaded.
# ══════════════════════════════════════════════════════
